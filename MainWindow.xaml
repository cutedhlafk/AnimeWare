<Window x:Class="VelocityStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Velocity Studio" Width="1180" Height="810" MinWidth="1040" MinHeight="730" WindowStartupLocation="CenterScreen" Background="#141216" FontFamily="pack://application:,,,/Assets/Fonts/#Inter 18pt" FontSize="13" Foreground="#F2EBF2">
 <Grid Background="#141216">
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#19161C" BorderBrush="#352D37" BorderThickness="0,0,1,0">
   <Grid Margin="18,28,18,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="12,0,0,34"><TextBlock Text="velocity" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="S T U D I O  /  0.1" FontSize="10" Foreground="#F28E9C" Margin="1,7,0,0"/></StackPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="PRZESTRZEŃ ROBOCZA" Style="{StaticResource Label}" Margin="12,0,0,14"/>
     <Button x:Name="AppearanceNav" Content="◈   Wygląd" Tag="appearance" Click="Navigate" Background="#49313E" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
     <Button x:Name="ProfilesNav" Content="▤   Profile" Tag="profiles" Click="Navigate" Background="Transparent" Margin="0,0,0,7"/>
     <Button x:Name="AssetsNav" Content="◇   Zasoby" Tag="assets" Click="Navigate" Background="Transparent"/>
    </StackPanel>
    <Border Grid.Row="3" Background="#28202C" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="●  Tryb samodzielny" Foreground="#F5A6B8" FontSize="12"/><TextBlock Text="Edytor wyglądu i profili.&#10;Bez połączenia z grą." Style="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="32,28,32,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TWÓJ PROJEKT / NOWY POCZĄTEK" Style="{StaticResource Label}"/><TextBlock x:Name="PageTitle" Text="Wygląd interfejsu" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Ciemny motyw. Łososiowy akcent. Twój styl." Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="Zapisz profil  ↗" Click="SaveProfile" VerticalAlignment="Center" Background="{DynamicResource Accent}" Foreground="#251B23" FontWeight="SemiBold"/></Grid>
   <Grid Grid.Row="1">
    <Grid x:Name="AppearancePage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18" Padding="20,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Jeden profil. Wszystkie detale." VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="PODGLĄD NA ŻYWO" Foreground="{DynamicResource Accent}" FontSize="10" VerticalAlignment="Center"/></Grid></Border>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
       <TextBlock Text="PERSONALIZACJA" Style="{StaticResource Label}"/><TextBlock Text="Twój styl" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
       <TextBlock Text="Nazwa profilu"/><TextBox x:Name="ProfileName" Text="Mój profil" MaxLength="48" Margin="0,8,0,14" TextChanged="SettingChanged"/>
       <TextBlock Text="Kolor akcentu"/><StackPanel Orientation="Horizontal" Margin="0,8,0,10"><Button Content="Łosoś" Tag="#F28E9C" Background="#F28E9C" Foreground="#251B23" Padding="10,9" Click="SelectAccent"/><Button Content="Różowy" Tag="#F5A6B8" Background="#F5A6B8" Foreground="#251B23" Padding="10,9" Margin="8,0" Click="SelectAccent"/><Button Content="Brzoskwinia" Tag="#F5A58E" Background="#F5A58E" Foreground="#251B23" Padding="10,9" Click="SelectAccent"/></StackPanel>
       <DockPanel><TextBlock Text="Skala podglądu"/><TextBlock x:Name="ScaleText" Text="100%" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}"/></DockPanel><Slider x:Name="ScaleSlider" Minimum="85" Maximum="115" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderChanged" Margin="0,8,0,14"/>
       <DockPanel><TextBlock Text="Krycie panelu"/><TextBlock x:Name="OpacityText" Text="95%" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}"/></DockPanel><Slider x:Name="OpacitySlider" Minimum="50" Maximum="100" Value="95" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderChanged" Margin="0,8,0,10"/>
       <CheckBox x:Name="WatermarkToggle" Content="Pokaż podpis w podglądzie" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="CompactToggle" Content="Kompaktowe odstępy" Checked="SettingChanged" Unchecked="SettingChanged"/>
       <Button Content="Przywróć domyślne" Click="ResetAppearance" Background="Transparent" HorizontalAlignment="Left" Padding="0,12" Foreground="#CAB4C9" Margin="0,6,0,0"/>
      </StackPanel></ScrollViewer></Border>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border Style="{StaticResource Card}" Padding="18" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="PODGLĄD INTERFEJSU" Style="{StaticResource Label}"/>
        <Grid Grid.Row="1"><Ellipse Width="220" Height="220" Stroke="#40313F" StrokeThickness="1"/><Ellipse Width="140" Height="140" Stroke="#40313F" StrokeThickness="1"/>
         <Border x:Name="PreviewPanel" Width="240" Background="#2C222F" BorderBrush="#654352" BorderThickness="1" CornerRadius="12" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="PreviewScale"/></Border.RenderTransform><StackPanel x:Name="PreviewItems">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="velocity" FontSize="22" FontWeight="SemiBold"/><Ellipse Grid.Column="1" Width="8" Height="8" Fill="{DynamicResource Accent}"/></Grid>
          <TextBlock x:Name="PreviewName" Text="Mój profil" Foreground="#B7A4B5" FontSize="11" Margin="0,4,0,20" TextTrimming="CharacterEllipsis"/>
          <Border Background="#3B2B3A" CornerRadius="6" Padding="10"><DockPanel><TextBlock Text="Akcent" FontSize="12"/><TextBlock x:Name="AccentValue" Text="Łosoś" FontSize="12" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/></DockPanel></Border>
          <Border x:Name="PreviewRow" Margin="0,10,0,0" Background="#3B2B3A" CornerRadius="6" Padding="10"><DockPanel><TextBlock Text="Układ" FontSize="12"/><TextBlock x:Name="LayoutValue" Text="Standardowy" FontSize="12" HorizontalAlignment="Right"/></DockPanel></Border>
          <Border Height="3" Background="{DynamicResource Accent}" CornerRadius="2" Margin="0,20,0,0"/>
         </StackPanel></Border>
        </Grid><TextBlock Grid.Row="2" x:Name="PreviewWatermark" Text="VELOCITY  /  STUDIO" FontSize="10" Foreground="#A2859B" HorizontalAlignment="Center" Margin="0,18,0,0"/>
       </Grid></Border>
       <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="18"><StackPanel><TextBlock Text="Fundament nowego projektu" FontWeight="SemiBold"/><TextBlock Text="Twój wygląd, nowy kod i ustawienia zapisane lokalnie." Style="{StaticResource Muted}" Margin="0,7,0,0" FontSize="12"/></StackPanel></Border>
      </Grid>
     </Grid>
    </Grid>
    <Grid x:Name="ProfilesPage" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="ZAPISANE PROFILE" Style="{StaticResource Label}"/><TextBlock x:Name="EmptyProfiles" DockPanel.Dock="Top" Text="Nie masz jeszcze zapisanych profili. Ustaw wygląd i wybierz „Zapisz profil”." Style="{StaticResource Muted}" Margin="0,12,0,20"/><ListBox x:Name="ProfilesList" DisplayMemberPath="Name"/></DockPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Twoje ustawienia" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Wybierz profil z listy, aby go wczytać lub wyeksportować." Style="{StaticResource Muted}" Margin="0,12,0,22"/><Button Content="Wczytaj wybrany" Click="LoadProfile" Margin="0,0,0,10"/><Button Content="Eksportuj JSON" Click="ExportProfile" Margin="0,0,0,10"/><Button Content="Importuj JSON" Click="ImportProfile" Background="Transparent"/><Border Height="1" Background="#413245" Margin="0,22"/><TextBlock Text="Profile są przechowywane lokalnie w folderze UserData obok aplikacji." Style="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
    </Grid>
    <ScrollViewer x:Name="AssetsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Twoja grafika. Twoja przestrzeń." FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Dodaj własną grafikę teraz lub później. Układ działa także bez niej; na start korzysta z czcionki Inter i prostych ikon." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TWOJA GRAFIKA / PNG LUB JPG" Style="{StaticResource Label}"/><Grid Height="155" Margin="0,20"><Border x:Name="BrandPlaceholder" BorderBrush="#654352" BorderThickness="1" CornerRadius="10"><StackPanel VerticalAlignment="Center"><TextBlock Text="＋" FontSize="36" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="Miejsce na Twój znak" HorizontalAlignment="Center" Foreground="#B7A4B5"/></StackPanel></Border><Image x:Name="BrandImage" Stretch="Uniform" Visibility="Collapsed"/></Grid><Button Content="Wczytaj własną grafikę" Click="ImportBrand"/><TextBlock Text="PNG lub JPG · do 20 MB · zapis lokalny" Style="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="TYPOGRAFIA / INTER" Style="{StaticResource Label}"/><TextBlock Text="Aa Bb Cc" FontSize="44" Margin="0,12"/><TextBlock Text="Zażółć gęślą jaźń.&#10;0123456789" FontSize="19" Margin="0,0,0,22"/><TextBlock Text="Regular + SemiBold" FontWeight="SemiBold"/><TextBlock Text="Osadzone czcionki — bez instalowania." Style="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel></Border>
     </Grid>
     <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="IKONY / 19 PLIKÓW SVG" Style="{StaticResource Label}"/><WrapPanel x:Name="IconGallery"/><TextBlock Text="Oryginalne wektory są zachowane w Assets/Icons." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Row="2" BorderBrush="#352D37" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,13,0,0"><TextBlock x:Name="StatusText" Text="Gotowe • ustawienia podglądu działają na żywo" Foreground="#B6A5B7" FontSize="11" TextWrapping="Wrap"/></Border>
  </Grid>
 </Grid>
</Window>

